{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies",
    ":pinDigestsDisabled"
  ],
  "packageRules": [
    {
      "matchFileNames": [".github/**/*.yml", ".tool-versions"],
      "groupName": "dev tools"
    },
    {
      "description": "Node: only even majors get an LTS line; odd ones are Current-only and stop getting security fixes about six months in. This toolchain builds the published npm bundle, so it stays on LTS. Raise the bound when the next even major reaches Active LTS.",
      "matchDatasources": ["node-version"],
      "allowedVersions": "<25"
    },
    {
      "matchFileNames": ["rebar.config"],
      "groupName": "rebar.config deps"
    },
    {
      "matchFileNames": ["package.json"],
      "groupName": "package.json deps"
    },
    {
      "matchFileNames": ["Dockerfile"],
      "groupName": "Docker deps"
    },
    {
      "enabled": false,
      "matchPackageNames": ["minimum_otp_vsn{/,}**"]
    }
  ],
  "customManagers": [
    {
      "description": "Match versions (per datasource and depName) in .github/**/*.yml",
      "customType": "regex",
      "managerFilePatterns": ["/.github/.*/.*\\.yml/"],
      "matchStrings": [
        "# renovate datasource: (?<datasource>[^,]+), depName: (?<depName>[^\\n]+)\\n.+?(?<currentValue>v?\\d+(\\.\\d+(\\.\\d+)?)?(-[^\\n]+)?)\\n"
      ]
    },
    {
      "description": "Match versions in rebar.config",
      "customType": "regex",
      "managerFilePatterns": ["/rebar.config/"],
      "datasourceTemplate": "hex",
      "matchStrings": [
        "{(?<depName>[^,]+), \"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "description": "Match versions (per datasource and depName) in Dockerfile",
      "customType": "regex",
      "managerFilePatterns": ["/Dockerfile/"],
      "matchStrings": [
        "# renovate datasource: (?<datasource>[^,]+), depName: (?<depName>[^\\n]+)\\nENV .+?_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "loose"
    }
  ]
}
