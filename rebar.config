%% The terminal render target calls `io_ansi`, which earlier releases lack. Remote
%% calls resolve at run time, so those still compile and only fail with `undef`
%% when something renders to a terminal; declaring it fails upfront instead.
{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% Render-target backends are called by arizona_parse_transform at compile
%% time, so they must be compiled before any module that uses the transform --
%% and so must arizona_utf8, which the native backend calls to name a value its
%% JSON encoder refuses.
{erl_first_files, [
    "src/arizona_renderer.erl",
    "src/arizona_utf8.erl",
    "src/arizona_html.erl",
    "src/arizona_native.erl",
    "src/arizona_terminal.erl"
]}.

{deps, [
    {roadrunner, "0.10.4"},
    {cowboy, "2.14.2"}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [
        compiler,
        syntax_tools,
        eunit,
        common_test,
        roadrunner,
        cowboy,
        cowlib,
        ranch,
        ssh,
        ssl,
        public_key,
        tools
    ]},
    {warnings, [
        unknown,
        unmatched_returns
    ]},
    incremental
]}.

{alias, [
    {test, [
        {eunit, "--cover"},
        {ct, "--cover"}
    ]},
    %% `--min_coverage` gates the PROJECT TOTAL, not each module -- rebar3 has no
    %% per-module floor. A thinly covered (even brand-new, 0%) module passes as
    %% long as the total holds, so read the `--verbose` per-module table rather
    %% than treating a green run as an 80% guarantee everywhere. (The JS side is
    %% stricter: vitest's `perFile: true`.)
    {check_cover, [
        {cover, "--min_coverage 80 --verbose"}
    ]},
    {doc, [
        ex_doc
    ]}
]}.

{profiles, [
    {default, [
        {xref_checks, [
            exports_not_used,
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]}
    ]},
    {test, [
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {erl_opts, [
            debug_info,
            nowarn_missing_spec,
            warnings_as_errors
        ]},
        {dialyzer, [
            {plt_apps, all_deps},
            {plt_extra_apps, [
                compiler,
                syntax_tools,
                eunit,
                common_test,
                roadrunner,
                cowboy,
                cowlib,
                ranch,
                telemetry,
                ssh,
                ssl,
                public_key,
                tools
            ]},
            {warnings, [
                unknown,
                unmatched_returns
            ]},
            incremental
        ]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_checks, [
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]},
        {xref_ignores, [{rebar_agent, do, 1}, {rebar_state, get, 3}]}
    ]},
    {eqwalizer, [
        {deps, [
            {eqwalizer_support,
                {git_subdir, "https://github.com/whatsapp/eqwalizer.git", {branch, "main"},
                    "eqwalizer_support"}}
        ]}
    ]}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_lint, "6.0.0"},
    {rebar3_hank, "2.0.1"},
    {rebar3_hex, "7.3.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{hank, [
    {ignore, [
        {"test/arizona_crypto_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_flash_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_session_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_req_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_jsonrpc_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_mcp_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_mcp_e2e_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_mcp_conformance_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_mcp_session_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_dev_mcp_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_router_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_pubsub_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_reloader_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_origin_SUITE.erl", [unnecessary_function_arguments]},
        {"test/arizona_session_store_SUITE.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_local_app.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_fake_watcher_init_only.erl", [unnecessary_function_arguments]},
        {"test/arizona_controller_SUITE.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_native_error_page.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_stateful_chrome.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_walk_child.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_walk_extra.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_walk_root.erl", [unnecessary_function_arguments]},
        {"include/arizona_effect.hrl", [single_use_hrl_attrs]},
        %% Callbacks whose arity their caller fixes: `erl_error`'s format_error/2,
        %% roadrunner's middleware/3, logger's log/2, and a fun the subscription
        %% helper calls with the channel.
        {"src/arizona_controller.erl", unnecessary_function_arguments, [{format_error, 2, 2}]},
        {"src/arizona_effect.erl", unnecessary_function_arguments, [{format_error, 2, 2}]},
        {"src/arizona_reloader_rule.erl", unnecessary_function_arguments, [{format_error, 2, 2}]},
        {"src/arizona_render.erl", unnecessary_function_arguments, [{format_error, 2, 2}]},
        {"src/arizona_roadrunner_router.erl", unnecessary_function_arguments, [
            {options_reply, 3, 3}
        ]},
        {"src/arizona_mcp_handler.erl", unnecessary_function_arguments, [{no_subscription, 1, 1}]},
        {"src/arizona_dev_log.erl", unnecessary_function_arguments, [{log, 2, 2}]},
        {"include/arizona_common.hrl", [unused_macros, single_use_hrl_attrs]},
        {"src/arizona_config.erl", [unnecessary_function_arguments]},
        {"src/arizona_crypto.erl", [unnecessary_function_arguments]},
        {"src/arizona_origin.erl", [unnecessary_function_arguments]},
        {"src/arizona_session.erl", [unnecessary_function_arguments]},
        {"src/arizona_template.erl", [unnecessary_function_arguments]},
        {"src/arizona_reloader.erl", [unnecessary_function_arguments]},
        {"src/arizona_renderer.erl", [unused_callbacks]},
        {"src/arizona_terminal_driver.erl", [unused_callbacks]},
        {"src/arizona_session_store.erl", [unused_callbacks]},
        {"src/arizona_watcher.erl", [unused_callbacks]},
        {"src/arizona_mcp.erl", [unused_callbacks]},
        {"src/arizona_server.erl", [unused_callbacks]}
    ]}
]}.

{erlfmt, [
    write,
    {files, [
        "elvis.config",
        "rebar.config",
        "scripts/*.escript",
        "src/*.app.src",
        "src/**/*.erl",
        "test/**/*.erl"
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CONTRIBUTING.md",
        "LICENSE.md",
        "docs/architecture.md",
        "docs/native.md",
        "docs/os.md",
        "docs/mcp.md",
        "docs/adapters.md"
    ]},
    {main, "README.md"},
    {api_reference, false},
    {source_url, "https://github.com/arizona-framework/arizona"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
